        "required": ["instanceId", "revision", "projects", "tasks", "attempts", "commands", "decisions", "results"],
        "properties": {"instanceId": {"type": "string"}, "revision": {"type": "integer", "format": "int64", "minimum": 0}, "projects": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/Project"}}, "tasks": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/Task"}}, "attempts": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/Attempt"}}, "commands": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/Command"}}, "decisions": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/Decision"}}, "results": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/Result"}, "description": "Map keyed by attempt ID + '/' + generation, not task ID. Operation journal is never exposed."}}
      },
      "RegisterProject": {"type": "object", "additionalProperties": false, "required": ["name", "path", "baseRef"], "properties": {"name": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "baseRef": {"type": "string", "minLength": 1}, "instructions": {"type": "string"}, "instructionFiles":{"type":"array","maxItems":16,"items":{"type":"string","minLength":1},"description":"Explicit Markdown policy files, relative to the repository or absolute; contents are snapshotted for future workers."}}},
      "CreateTask": {
